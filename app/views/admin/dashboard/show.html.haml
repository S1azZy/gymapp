%main.admin-page
  .admin-page__header
    .admin-page__heading
      %p.admin-page__eyebrow= t("admin.dashboard.eyebrow")
      %h1= t("admin.dashboard.title")
      %p.admin-page__subtitle
        = t("admin.dashboard.subtitle", email: current_user.email)

  .reference-grid
    - @resource_cards.each do |card|
      :ruby
        resource_key = card[:resource_key]
        resource_name = admin_reference_resource_label(resource_key, :plural)
        singular_resource_name =
          admin_reference_resource_label(resource_key, :singular)
        new_resource_label =
          admin_reference_action_label(:new, singular_resource_name)
      %section.reference-card
        %h2= resource_name
        %p= t("admin.dashboard.sections.reference_data")
        %p.reference-card__meta
          = admin_dashboard_resource_count_text(card[:count])
        .reference-card__actions
          = link_to admin_reference_action_label(:open),
            admin_dashboard_resource_path(resource_key),
            class: "primary-link"
          = link_to new_resource_label,
            admin_dashboard_new_resource_path(resource_key),
            class: "secondary-link secondary-link--compact"

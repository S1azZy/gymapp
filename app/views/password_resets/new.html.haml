%main.auth-page
  %section.auth-card
    %h1= t("auth.password_resets.new.title")
    %p.auth-card__subtitle= t("auth.password_resets.new.subtitle")
    - request_submit_label = t("auth.password_resets.form.request_submit")

    = auth_form_with url: password_resets_path, scope: :password_reset do |form|
      .auth-form__field
        = form.label :email, t("auth.password_resets.form.email")
        = form.email_field :email, autocomplete: "email", required: true

      = form.submit request_submit_label, class: "auth-form__submit"

%main.auth-page
  %section.auth-card
    %h1= t("auth.sessions.new.title")
    %p.auth-card__subtitle= t("auth.sessions.new.subtitle")
    :ruby
      forgot_password_label = t("auth.sessions.new.forgot_password")
      forgot_password_path = new_password_reset_path

    = auth_form_with url: session_path, scope: :session do |form|
      .auth-form__field
        = form.label :email, t("auth.sessions.form.email")
        = form.email_field :email, autocomplete: "email", required: true

      .auth-form__field
        = form.label :password, t("auth.sessions.form.password")
        = form.password_field :password,
          autocomplete: "current-password",
          required: true

      = form.submit t("auth.sessions.form.submit"), class: "auth-form__submit"

    %p.auth-card__footer
      = secondary_link_to forgot_password_label, forgot_password_path

%main.auth-page
  %section.auth-card
    %h1= t("auth.users.new.title")
    %p.auth-card__subtitle= t("auth.users.new.subtitle")

    = form_with model: @user, class: "auth-form" do |form|
      .auth-form__field
        = form.label :email, t("auth.users.form.email")
        = form.email_field :email, autocomplete: "email", required: true

      .auth-form__field
        = form.label :password, t("auth.users.form.password")
        = form.password_field :password,
          autocomplete: "new-password",
          required: true

      .auth-form__field
        = form.label :password_confirmation,
          t("auth.users.form.password_confirmation")
        = form.password_field :password_confirmation,
          autocomplete: "new-password",
          required: true

      = form.submit t("auth.users.form.submit"), class: "auth-form__submit"

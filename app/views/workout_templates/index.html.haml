- content_for :title, t("workout_templates.index.title")

%main.catalog-page
  .catalog-page__header
    .catalog-page__heading
      %p.catalog-page__eyebrow= t("workout_templates.eyebrow")
      %h1= t("workout_templates.index.title")
      %p.catalog-page__subtitle= t("workout_templates.index.subtitle")
    = link_to t("workout_templates.actions.new"),
      new_workout_template_path,
      class: "primary-link"

  - if @workout_templates.any?
    .catalog-grid
      - @workout_templates.each do |workout_template|
        :ruby
          status_text = workout_template_status_text(
            workout_template
          )
          exercise_count_text = workout_template_exercise_count_text(
            workout_template
          )
        %article.catalog-card
          .catalog-card__header
            %div
              %p.catalog-card__key= status_text
              = link_to workout_template.name,
                workout_template_path(workout_template),
                class: "catalog-card__title"
            .catalog-chip-list
              %span.catalog-chip= exercise_count_text
          - if workout_template.notes.present?
            %p.catalog-card__description= workout_template.notes
          .reference-form__actions
            = secondary_link_to t("workout_templates.actions.edit"),
              edit_workout_template_path(workout_template)
            = button_to t("workout_templates.actions.delete"),
              workout_template_path(workout_template),
              method: :delete,
              class: "secondary-link",
              data: { turbo_confirm: t("workout_templates.confirm_delete") }
  - else
    %p.catalog-empty= t("workout_templates.index.empty")
